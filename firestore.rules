rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /decorations/{decorationId} {
      allow read, write: if true;
    }
    match /app_config/{configId} {
      allow read, write: if true;
    }
    match /bookings/{bookingId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
